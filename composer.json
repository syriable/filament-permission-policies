{
    "name": "syriable/filament-permission-policies",
    "description": "A context-aware permission presentation layer on top of Filament Shield.",
    "keywords": [
        "laravel",
        "filament",
        "filament-shield",
        "permissions",
        "roles",
        "spatie"
    ],
    "homepage": "https://github.com/syriable/filament-permission-policies",
    "license": "MIT",
    "authors": [
        {
            "name": "Syriable",
            "email": "alkhatib.syr@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\PermissionPolicies\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syriable\\Filament\\Plugins\\PermissionPolicies\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syriable\\Filament\\Plugins\\PermissionPolicies\\PermissionPoliciesServiceProvider"
            ],
            "aliases": {
                "PermissionPolicies": "Syriable\\Filament\\Plugins\\PermissionPolicies\\Facades\\PermissionPolicies"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
